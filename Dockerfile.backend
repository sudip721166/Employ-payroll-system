# Backend Dockerfile (for Render or Docker Compose)
FROM node:20-alpine

# Create app directory
WORKDIR /usr/src/app

# Install production dependencies
COPY backend/package*.json ./
RUN npm ci --only=production

# Copy app source
COPY backend/ .

# Expose default port
ENV NODE_ENV=production
EXPOSE 3000

# Start the app
CMD ["node", "server.js"]
